# ===== 扣子工作流配置模板：复制为 .env 并填写真实值 =====
COZE_PAT=在这里填入你的个人访问密钥
COZE_WORKFLOW_ID=在这里填入工作流ID
COZE_API_BASE=https://api.coze.cn

# 工作流输入参数名映射（改成你工作流开始节点的真实参数名）
CZ_PARAM_TEXT=contract_text
CZ_PARAM_TYPE=contract_type
CZ_PARAM_STANCE=review_stance
CZ_PARAM_FOCUS=focus_areas
CZ_PARAM_EXTRA=extra_requirements
